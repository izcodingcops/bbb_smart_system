{
  "name": "bbb_smart_system",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "graphql:smoke": "tsc --module commonjs --moduleResolution node10 --target es2020 --esModuleInterop --skipLibCheck --outDir .smoke scripts/graphqlSmoke.ts && node .smoke/scripts/graphqlSmoke.js",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "migration:smoke": "tsc --module commonjs --moduleResolution node10 --target es2020 --esModuleInterop --skipLibCheck --outDir .smoke scripts/migrationSmoke.ts && node .smoke/scripts/migrationSmoke.js",
    "outbox:smoke": "tsc --module commonjs --moduleResolution node10 --target es2020 --esModuleInterop --skipLibCheck --outDir .smoke scripts/outboxSmoke.ts && node .smoke/scripts/outboxSmoke.js",
    "start": "react-native start"
  },
  "dependencies": {
    "@apollo/client": "4.2.8",
    "@graphql-tools/schema": "^10.0.38",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.15",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@reduxjs/toolkit": "^2.11.2",
    "graphql": "^16.14.2",
    "react": "19.2.3",
    "react-native": "0.85.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.29.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.5",
    "react-native-vision-camera": "^4.7.3",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.1",
    "@react-native/eslint-config": "0.85.1",
    "@react-native/metro-config": "0.85.1",
    "@react-native/typescript-config": "0.85.1",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.12",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
